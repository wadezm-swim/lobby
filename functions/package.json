{
  "name": "lobby-functions",
  "private": true,
  "description": "Lobby's cloud: scheduled fetches for F1, AFL and news, and captures to Notion.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
