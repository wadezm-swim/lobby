rules_version = '2';

// Lobby is a one-person app. The sports and news documents hold public facts
// (F1 schedules, the AFL ladder, headlines) and are readable without a login,
// because the Mac app can't sign in until it's properly signed. Each user owns
// their own captures. Only the cloud writes the sports and news documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /sports/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /system/{doc} {
      allow read, write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
